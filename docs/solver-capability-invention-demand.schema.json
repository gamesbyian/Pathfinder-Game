{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pathfinder.solver-capability-invention-demand/v1",
  "title": "Pathfinder solver capability-invention demand register",
  "type": "object",
  "required": ["schemaVersion", "purpose", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "productionBoundary": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"], "format": "date" },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "firstLossClass": {
      "enum": [
        "F0", "F1", "F2", "F3", "F4", "F5", "F6", "F7",
        "F8", "F9", "F10", "F11", "F12", "F13", "F14",
        "UNRESOLVED_EARLIER_CLASS"
      ]
    },
    "atlasDimension": {
      "enum": [
        "representation",
        "inference",
        "composition",
        "persistence",
        "action",
        "revision",
        "communication",
        "reachability",
        "search-object",
        "information"
      ]
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "diagnosisStatus",
        "firstLossClass",
        "workClass",
        "evidenceRefs",
        "demand",
        "atlasDimensions",
        "smallestProbe",
        "recurrenceScope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CID-[0-9]{4}$"
        },
        "subject": {
          "type": "object",
          "required": ["levelId", "population"],
          "properties": {
            "levelId": { "type": "string", "minLength": 1 },
            "population": { "type": "string", "minLength": 1 },
            "corpus": { "type": ["string", "null"] },
            "parentId": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "diagnosisStatus": {
          "enum": ["resolved", "partial", "unresolved"]
        },
        "firstLossClass": { "$ref": "#/$defs/firstLossClass" },
        "workClass": {
          "enum": ["HARVEST", "EXTENSION", "INVENTION", "UNKNOWN"]
        },
        "evidenceStrength": {
          "enum": ["forensic", "development", "confirmation", "production-boundary", "unknown"]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "unresolvedEarlierClasses": {
          "type": "array",
          "items": { "$ref": "#/$defs/firstLossClass" },
          "uniqueItems": true
        },
        "minimalCounterfactual": {
          "type": ["string", "null"]
        },
        "demand": {
          "type": "string",
          "minLength": 1
        },
        "atlasDimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/atlasDimension" },
          "uniqueItems": true
        },
        "smallestProbe": {
          "type": "object",
          "required": ["question", "decisionSeam", "advanceIf"],
          "properties": {
            "question": { "type": "string", "minLength": 1 },
            "decisionSeam": { "type": "string", "minLength": 1 },
            "advanceIf": { "type": "string", "minLength": 1 },
            "stopIf": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "recurrenceScope": {
          "enum": [
            "single-observation",
            "single-parent",
            "multiple-independent-parents",
            "population-level"
          ]
        },
        "notes": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  }
}
