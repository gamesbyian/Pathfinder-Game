{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pathfinder://schemas/solver-experiment-result-v3",
  "title": "Pathfinder solver experiment result",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "experiment",
    "researchQuestion",
    "population",
    "execution",
    "limits",
    "outcomes",
    "coverage",
    "researchOutcome",
    "sideEffects",
    "decisionBearing",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "pathfinder-solver-experiment-result"
    },
    "experiment": {
      "type": "object",
      "required": [
        "experimentId",
        "workflowFamily",
        "producer",
        "entrypoint",
        "requestedRef",
        "resolvedSha",
        "arms",
        "workflowRunId",
        "workflowRunAttempt",
        "sourceRuns",
        "reconciliationRun",
        "configurationHash"
      ],
      "properties": {
        "experimentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer": {
          "type": [
            "string",
            "null"
          ]
        },
        "entrypoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestedRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolvedSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowRunAttempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRuns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reconciliationRun": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "sourceRuns",
                "preservesExperimentIdentity",
                "acquisitionRecomputed"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "recombine-only",
                    "reanalyze-only",
                    "retry-missing-acquisition"
                  ]
                },
                "sourceRuns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "preservesExperimentIdentity": {
                  "type": "boolean"
                },
                "acquisitionRecomputed": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "configurationHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceProtocolHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceSetHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "arms": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "population": {
      "type": "object",
      "required": [
        "kind",
        "identityBasis",
        "identityHash",
        "expectedCount",
        "observedCount",
        "duplicateIds",
        "unexpectedIds",
        "missingIds"
      ],
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "identityBasis": {
          "type": [
            "string",
            "null"
          ]
        },
        "identityHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expectedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duplicateIds": {
          "$ref": "#/$defs/stringList"
        },
        "unexpectedIds": {
          "$ref": "#/$defs/stringList"
        },
        "missingIds": {
          "$ref": "#/$defs/stringList"
        },
        "corpusIdentity": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection": {
          "type": [
            "object",
            "array",
            "string",
            "null"
          ]
        },
        "researchBlock": {
          "type": [
            "object",
            "null"
          ]
        },
        "independentUnit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "levelBlind",
        "historyAware",
        "historicalInputs",
        "reproducibilityExpected",
        "producerFamily",
        "schedulerMode"
      ],
      "properties": {
        "levelBlind": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "historyAware": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "historicalInputs": {
          "$ref": "#/$defs/stringList"
        },
        "reproducibilityExpected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "producerFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "schedulerMode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "cumulativeNodeCeiling",
        "initialWorkAllocation",
        "totalWorkCeiling",
        "wallSafetyDeadlineMs",
        "wallDeadlineBinding"
      ],
      "properties": {
        "cumulativeNodeCeiling": {
          "$ref": "#/$defs/number"
        },
        "initialWorkAllocation": {
          "$ref": "#/$defs/number"
        },
        "totalWorkCeiling": {
          "$ref": "#/$defs/number"
        },
        "wallSafetyDeadlineMs": {
          "$ref": "#/$defs/number"
        },
        "wallDeadlineBinding": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "representation": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": [
        "object",
        "null"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "artifact",
        "populationIntegrity"
      ],
      "properties": {
        "artifact": {
          "type": [
            "object",
            "null"
          ]
        },
        "populationIntegrity": {
          "anyOf": [
            {
              "$ref": "#/$defs/populationIntegrity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "researchOutcome": {
      "type": [
        "object",
        "null"
      ]
    },
    "sideEffects": {
      "type": "object",
      "required": [
        "hints",
        "canonicalBaseline",
        "telemetry",
        "reports"
      ],
      "additionalProperties": {
        "enum": [
          "unknown",
          "none",
          "artifact-only",
          "harvest-permitted",
          "canonical-write",
          "baseline-replace",
          "telemetry-update",
          "report-write",
          "compact"
        ]
      }
    },
    "decisionBearing": {
      "type": "boolean"
    },
    "entries": {
      "type": "array"
    },
    "researchQuestion": {
      "type": [
        "object",
        "null"
      ]
    },
    "sourceRunBinding": {
      "anyOf": [
        {
          "$ref": "#/$defs/sourceRunBinding"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "number": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "populationIntegrity": {
      "type": "object",
      "required": [
        "expectedCount",
        "observedCount",
        "duplicateIds",
        "unexpectedIds",
        "missingIds",
        "coverageComplete",
        "decisionValidComplete",
        "outcomes"
      ],
      "properties": {
        "expectedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duplicateIds": {
          "$ref": "#/$defs/stringList"
        },
        "unexpectedIds": {
          "$ref": "#/$defs/stringList"
        },
        "missingIds": {
          "$ref": "#/$defs/stringList"
        },
        "coverageComplete": {
          "type": "boolean",
          "description": "Every intended subject has exactly one structurally usable row. This does not imply scientific interpretability."
        },
        "decisionValidComplete": {
          "type": "boolean",
          "description": "Coverage is complete and no row is deadline-truncated, harness-error, malformed, missing, or unknown. Node/work-limited rows remain valid bounded-envelope observations."
        },
        "complete": {
          "type": "boolean",
          "description": "Compatibility alias for coverageComplete; decision-bearing consumers must use decisionValidComplete."
        },
        "outcomes": {
          "type": "object"
        },
        "populationIdentityHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expectedIds": {
          "$ref": "#/$defs/stringList"
        },
        "inferredExpectedPopulation": {
          "type": "boolean"
        },
        "intendedPopulationKnown": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "sourceRunBinding": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "runId",
        "runAttempt",
        "contractRef",
        "workflowFamily",
        "producer",
        "entrypoint",
        "solverRef",
        "configurationHash",
        "protocolHash",
        "populationIdentity",
        "corpusIdentity",
        "arm",
        "sourceRuns"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "pathfinder-solver-source-run-binding"
        },
        "runId": {
          "type": "string"
        },
        "runAttempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "contractRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer": {
          "type": [
            "string",
            "null"
          ]
        },
        "entrypoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "solverRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "protocolHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "populationIdentity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "corpusIdentity": {
          "type": [
            "string",
            "null"
          ]
        },
        "arm": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRuns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
