{
  // Whole-tree static typing (ADR 0011): `tsc --noEmit` type-checks every modules/**/*.ts.
  // The .js→.ts migration is complete — the only modules/ files still .js are the two
  // Worker-boundary exclusions (solver/worker.js, solver/solver-worker-client.js). Emit is
  // handled by Vite at build time (ADR 0010); tsc here is check-only.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    // Cache the check-only run between invocations (node_modules/.cache so `npm ci` — and
    // therefore GitHub Actions — always starts cold; only local re-runs get the speedup).
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "modules/**/*.ts",
    "scripts/ablation-config.mjs"
  ],
  // Colocated *.test.ts are strict-checked separately (tsconfig.test.json adds node types for
  // node:assert). Kept out of this source check so production code is validated under the DOM env only.
  "exclude": [
    "modules/**/*.test.ts"
  ]
}
