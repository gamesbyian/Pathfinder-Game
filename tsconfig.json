{
  // Check-only static typing (modernization-plan §5 / ADR 0009): `tsc --noEmit` type-checks a
  // curated allowlist of `// @ts-check`'d modules. There is NO build/emit step — the browser still
  // loads the .js directly (ADR 0001). Grow `include` as modules are annotated and made to pass.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "modules/domain/types.js",
    "modules/domain/cell-key.js",
    "modules/domain/geometry.js",
    "modules/domain/move-context.js",
    "modules/domain/portal-utils.js",
    "modules/domain/heatmap.js",
    "modules/domain/move-rules.js",
    "modules/domain/path-validator.js",
    "modules/runtime/actions.js",
    "modules/runtime/effects.js",
    "modules/runtime/state-machine.js",
    "modules/runtime/game-rules.js",
    "modules/solver/types.js",
    "modules/solver/encoding.js",
    "modules/solver/distance.js",
    "modules/solver/archetype.js",
    "modules/solver/solution.js",
    "modules/solver/search-state.js",
    "modules/solver/topology.js",
    "modules/solver/lower-bounds.js",
    "modules/solver/scoring.js",
    "modules/solver/policy.js"
  ]
}
