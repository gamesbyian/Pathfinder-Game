{
  // Check-only static typing (modernization-plan §5 / ADR 0009): `tsc --noEmit` type-checks a
  // curated allowlist of `// @ts-check`'d modules. There is NO build/emit step — the browser still
  // loads the .js directly (ADR 0001). Grow `include` as modules are annotated and made to pass.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "modules/**/*.ts",
    "modules/solver/types.js",
    "modules/solver/encoding.js",
    "modules/solver/distance.js",
    "modules/solver/archetype.js",
    "modules/solver/solution.js",
    "modules/solver/search-state.js",
    "modules/solver/topology.js",
    "modules/solver/lower-bounds.js",
    "modules/solver/scoring.js",
    "modules/solver/policy.js",
    "modules/solver/attempts.js",
    "modules/solver/search.js",
    "modules/solver/prep.js",
    "modules/solver/orchestration.js",
    "modules/solver/trap-search.js",
    "modules/solver/normalization.js",
    "modules/solver/testing-api.js",
    "modules/theme-engine.js",
    "modules/theme/theme-normalizer.js",
    "modules/theme/theme-registry.js",
    "modules/editor/editor-model.js",
    "modules/editor/editor-history.js",
    "modules/state-slices.js",
    "modules/editor/editor-export.js",
    "modules/editor/editor-occupancy.js",
    "modules/persistence/level-rating-repository.js",
    "modules/persistence/level-submission-repository.js",
    "scripts/ablation-config.mjs",
    "modules/solver/diversification.js",
    "modules/persistence/review-repository.js",
    "modules/state/actions/shared.js",
    "modules/state/actions/core-actions.js",
    "modules/state/actions/navigation-actions.js",
    "modules/state/actions/hazard-actions.js",
    "modules/state/actions/hint-actions.js",
    "modules/state/actions/solver-actions.js",
    "modules/state/actions/review-actions.js",
    "modules/state/actions/editor-actions.js",
    "modules/state/actions/ui-actions.js",
    "modules/state/actions/runtime-actions.js",
    "modules/state/actions/rating-actions.js",
    "modules/state-actions.js",
    "modules/state.js",
    "modules/SolverV2.js",
    "modules/data.js",
    "modules/debug.js",
    "modules/engine/win-controller.js"
  ]
}
