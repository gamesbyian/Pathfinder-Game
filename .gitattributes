# Source/config files are text even if a historical revision embedded a literal NUL in a string.
*.mjs text eol=lf diff

# Large machine-produced evidence/data: keep tracked and exact, but let GitHub collapse generated
# diffs and exclude them from source-language statistics. Do not mark authored level definitions.
data/hints/*.json linguist-generated=true
data/level-heatmaps.json linguist-generated=true
data/stress/stress-levels*.json linguist-generated=true
data/stress/hints/**/*.json linguist-generated=true
data/stress/hints-*/**/*.json linguist-generated=true
logs/**/*.json linguist-generated=true
