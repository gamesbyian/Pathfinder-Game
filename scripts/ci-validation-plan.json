    "research": {
      "validatorGroups": [
        "research"
      ],
      "nodeTestGroups": [
        "research"
      ],
      "capabilities": []
    },
    "data": {
      "validatorGroups": [
        "data"
      ],
      "nodeTestGroups": [
        "data"
      ],
      "capabilities": []
    },
    "game": {
      "validatorGroups": [
        "game"
      ],
      "nodeTestGroups": [
        "game"
      ],
      "capabilities": [
        "unit-coverage",
        "build"
      ]
    },
    "persistence": {
      "validatorGroups": [],
      "nodeTestGroups": [
        "persistence"
      ],
      "capabilities": [
