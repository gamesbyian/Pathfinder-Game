  "capabilities": {
    "lint": {
      "packageScript": "check:lint",
      "workflowStepId": "lint",
      "note": "Kept universal initially; narrow only after source-scope measurements."
    },
    "unit-coverage": {
      "packageScript": "test:coverage",
      "workflowStepId": "coverage",
      "note": "Current coarse covered implementation population; later partition only if measurements justify it."
    },
    "deep-proofs": {
      "packageScript": "test:deep-proofs",
      "workflowStepId": "deep_services",
      "note": "Heavyweight solver proofs; co-executed with Firestore under deep_services while preserving independent result output."
    },
    "build": {
      "packageScript": "build",
      "workflowStepId": "build",
      "note": "Production Vite bundle."
    },
    "firestore-boundary": {
      "packageScript": "test:firestore-level-fingerprint-boundary",
