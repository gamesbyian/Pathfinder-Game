{
  "schemaVersion": 1,
  "surfaces": [
    "repo",
    "game",
    "persistence",
    "solver",
    "research",
    "data",
    "shared"
  ],
  "fallback": "all",
  "policy": {
    "firstMatchWins": true,
    "unknown": "all",
    "note": "Active conservative classifier. all means every semantic surface. Unknown/router authorities still escalate, while downstream invalidation should be encoded on contracts rather than by wholesale consumer-surface escalation."
  },
  "rules": [
    {
      "id": "ci-routing-infrastructure",
      "pattern": "^(?:\\.github/|scripts/(?:ci-(?:impact|validation-plan|execution-plan|node-concurrency-benchmark)[^/]*|validation-groups|check-ci-gate-parity|check-ci-validation-plan-parity|check-package-scripts|run-scripts-parallel)\\.)",
      "surfaces": [
        "all"
      ],
      "reason": "CI/router/workflow authority"
    },
    {
      "id": "package-build-authority",
      "pattern": "^(?:package(?:-lock)?\\.json|tsconfig(?:\\.[^/]+)?\\.json|vite\\.config\\.[^/]+|vitest(?:\\.[^/]+)?\\.config\\.[^/]+|eslint\\.config\\.[^/]+)$",
      "surfaces": [
        "all"
      ],
      "reason": "dependency/build/type/test/config authority"
    },
    {
      "id": "git-attribute-authority",
      "pattern": "^\\.gitattributes$",
      "surfaces": [
        "all"
      ],
      "reason": "repository-wide Git attribute semantics"
    },
    {
      "id": "repository-root-metadata",
      "pattern": "^(?:\\.gitignore|CLAUDE\\.md|README\\.md)$",
      "surfaces": [
        "repo"
      ],
      "reason": "repository metadata/agent/project documentation"
    },
    {
      "id": "game-test-config",
      "pattern": "^playwright\\.config\\.mjs$",
      "surfaces": [
        "game",
        "repo"
      ],
      "reason": "browser test execution configuration"
    },
    {
      "id": "game-tests",
      "pattern": "^tests/",
      "surfaces": [
        "game"
      ],
      "reason": "browser/E2E/visual test surface and snapshots"
    },
    {
      "id": "research-archive",
      "pattern": "^research/",
      "surfaces": [
        "research"
      ],
      "reason": "research workspace/evidence material"
    },
    {
      "id": "game-security-config",
      "pattern": "^security/",
      "surfaces": [
        "game",
        "repo"
      ],
      "reason": "browser security/CSP policy authority"
    },
    {
      "id": "game-host-config",
      "pattern": "^includes/",
      "surfaces": [
        "game"
      ],
      "reason": "production client/hosting configuration"
    },
    {
      "id": "firestore-authority",
      "pattern": "^(?:firebase\\.json|firestore\\.(?:rules|indexes\\.json))$",
      "surfaces": [
        "repo",
        "persistence"
      ],
      "reason": "Firestore deployment/emulator authority"
    },
    {
      "id": "firebase-client-config",
      "pattern": "^firebase-config\\.js$",
      "surfaces": [
        "game",
        "persistence"
      ],
      "reason": "production Firebase client configuration"
    },
    {
      "id": "persistence-modules",
      "pattern": "^modules/persistence(?:/|\\.)",
      "surfaces": [
        "game",
        "persistence"
      ],
      "reason": "production persistence implementation"
    },
    {
      "id": "production-solver",
      "pattern": "^modules/(?:solver(?:/|\\.(?:ts|js)$)|solver\\.ts$)",
      "surfaces": [
        "solver"
      ],
      "reason": "production solver producer; explicit contract surfaces carry downstream invalidation"
    },
    {
      "id": "shared-domain",
      "pattern": "^modules/domain/",
      "surfaces": [
        "game",
        "solver",
        "research"
      ],
      "reason": "shared executable domain semantics; known game/solver/research surfaces now select explicit multi-surface contracts without whole shared-bucket escalation"
    },
    {
      "id": "game-modules",
      "pattern": "^modules/(?:ui|render|input|engine|persistence|runtime|state|theme)(?:/|\\.)|^modules/(?:app|boot|editor|audio-service|data|debug|error-reporting|level-data|ports|state-slices)\\.",
      "surfaces": [
        "game"
      ],
      "reason": "browser/game/runtime implementation"
    },
    {
      "id": "game-assets",
      "pattern": "^(?:styles/|public/|index\\.html$)",
      "surfaces": [
        "game"
      ],
      "reason": "production browser assets"
    },
    {
      "id": "runtime-data",
      "pattern": "^data/(?:levels\\.json|level-heatmaps\\.json|themes\\.json|hints(?:/|$))",
      "surfaces": [
        "data",
        "game",
        "solver",
        "research"
      ],
      "reason": "runtime-shipped data consumed by game and solver"
    },
    {
      "id": "research-data",
      "pattern": "^data/(?:stress|families)(?:/|$)",
      "surfaces": [
        "data",
        "research"
      ],
      "reason": "research population/corpus/family assets"
    },
    {
      "id": "research-reports",
      "pattern": "^(?:reports/|logs/)",
      "surfaces": [
        "research"
      ],
      "reason": "research evidence/report surfaces"
    },
    {
      "id": "solver-research-docs",
      "pattern": "^docs/(?:solver-|variant-level-research|human-parent-contrast-research|technique-census-analysis)",
      "surfaces": [
        "repo",
        "research"
      ],
      "reason": "solver research/architecture authorities and premise inputs"
    },
    {
      "id": "research-forensic-scripts",
      "pattern": "^scripts/(?:connectivity-|append-solver-health-record)",
      "surfaces": [
        "research"
      ],
      "reason": "research-only forensic/health tooling downstream of production solver"
    },
    {
      "id": "research-scripts",
      "pattern": "^scripts/(?:stress/|research-|analyze-|capture-|annotate-|combine-|family-|hint-|solver-|ablation-|technique-|experiment-|failure-|sweep-|portfolio-|method-|cpsat-|known-|class|reserve-|capability-|freeze-|write-solver|publish-solver|validate-solver)",
      "surfaces": [
        "research"
      ],
      "reason": "downstream research/tooling consumers"
    },
    {
      "id": "repository-docs",
      "pattern": "^(?:AGENTS\\.md$|DEVELOPER_REFERENCE\\.md$|docs/|reports/README\\.md$|scripts/README\\.md$)",
      "surfaces": [
        "repo"
      ],
      "reason": "repository documentation/agent authority"
    },
    {
      "id": "other-data",
      "pattern": "^data/",
      "surfaces": [
        "data",
        "shared"
      ],
      "reason": "unclassified data with conservative shared escalation"
    },
    {
      "id": "other-modules",
      "pattern": "^modules/",
      "surfaces": [
        "game",
        "shared"
      ],
      "reason": "unclassified executable module"
    },
    {
      "id": "other-scripts",
      "pattern": "^scripts/",
      "surfaces": [
        "repo",
        "shared"
      ],
      "reason": "unclassified executable tooling"
    }
  ]
}
