{
  "name": "pathfinder-game",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:solver": "node scripts/lint-solver-no-undef.mjs",
    "test:solver-smoke": "node scripts/solver-smoke-test.mjs",
    "check:audit-output": "node scripts/check-audit-output.mjs",
    "test:hint-path-oracle": "node scripts/hint-path-oracle.mjs",
    "test:hint-path-replay": "node scripts/hint-path-replay.mjs --output=audits/hint-path-replay/latest.json",
    "test:portal-cross-realm": "node scripts/portal-cross-realm-solve-test.mjs",
    "ci": "npm run lint:solver && npm run test:solver-smoke && npm run test:startup-smoke && npm run test:hint-path-oracle && npm run test:portal-cross-realm",
    "test:startup-smoke": "node scripts/startup-smoke-test.mjs",
    "audit:newhint:full": "node scripts/run-audit-export.mjs",
    "audit:levels": "node scripts/run-level-audit.mjs",
    "solver:direct": "node scripts/run-solver-direct.mjs",
    "audit:analyze-failures": "node scripts/analyze-audit-failures.mjs",
    "audit:check-hard-levels": "node scripts/check-persistent-hard-levels.mjs",
    "audit:check-hard-levels:strict": "node scripts/check-persistent-hard-levels.mjs --enforce-solved",
    "audit:check-regressions": "node scripts/check-regression-levels.mjs --levels=7 --window=3 --max-consecutive-failures=1",
    "audit:heuristic-recall": "node scripts/audit-heuristic-recall.mjs --levels=92,108,134 --output=audits/heuristic-recall/latest.json",
    "ablation:baseline": "node scripts/solver-ablation.mjs --experiment=baseline --levels=all",
    "ablation:disable-one": "node scripts/solver-ablation.mjs --experiment=disable-one --levels=all",
    "ablation:solo": "node scripts/solver-ablation.mjs --experiment=solo --levels=all",
    "ablation:budget-sweep": "node scripts/solver-ablation.mjs --experiment=budget-sweep --levels=all",
    "ablation:full": "node scripts/solver-ablation.mjs --experiment=full --levels=all",
    "ablation:technique-budget": "node scripts/solver-ablation.mjs --experiment=technique-budget --levels=all",
    "ablation:analyze": "node scripts/analyze-ablation.mjs"
  },
  "devDependencies": {
    "playwright": "^1.54.2"
  }
}
