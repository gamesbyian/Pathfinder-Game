{
  "name": "pathfinder-game",
  "private": true,
  "type": "module",
  "scripts": {
    "check:audit-output": "node scripts/check-audit-output.mjs",
    "test:hint-path-oracle": "node scripts/hint-path-oracle.mjs",
    "ci": "npm run test:startup-smoke && npm run test:hint-path-oracle",
    "test:startup-smoke": "node scripts/startup-smoke-test.mjs",
    "audit:newhint:full": "node scripts/run-audit-export.mjs",
    "audit:levels": "node scripts/run-level-audit.mjs",
    "solver:direct": "node scripts/run-solverv2-direct.mjs",
    "audit:analyze-failures": "node scripts/analyze-audit-failures.mjs",
    "audit:check-hard-levels": "node scripts/check-persistent-hard-levels.mjs",
    "audit:check-hard-levels:strict": "node scripts/check-persistent-hard-levels.mjs --enforce-solved",
    "audit:check-regressions": "node scripts/check-regression-levels.mjs --levels=7 --window=3 --max-consecutive-failures=1",
    "audit:heuristic-recall": "node scripts/audit-heuristic-recall.mjs --levels=92,108,134 --output=audits/heuristic-recall/latest.json",
    "legacy:solver-smoke": "node LegacySolver/solver-smoke-test.mjs",
    "legacy:hint-path-replay": "node LegacySolver/hint-path-replay.mjs --output=audits/hint-path-replay/latest.json",
    "legacy:portal-cross-realm": "node LegacySolver/portal-cross-realm-solve-test.mjs",
    "legacy:portal-ui-path": "node LegacySolver/portal-ui-path-solve-test.mjs",
    "legacy:portal-dev-mode": "node LegacySolver/portal-dev-mode-solve-test.mjs",
    "legacy:solver-direct": "node LegacySolver/run-solver-direct.mjs",
    "legacy:ablation:baseline": "node LegacySolver/solver-ablation.mjs --experiment=baseline --levels=all",
    "legacy:ablation:disable-one": "node LegacySolver/solver-ablation.mjs --experiment=disable-one --levels=all",
    "legacy:ablation:solo": "node LegacySolver/solver-ablation.mjs --experiment=solo --levels=all",
    "legacy:ablation:budget-sweep": "node LegacySolver/solver-ablation.mjs --experiment=budget-sweep --levels=all",
    "legacy:ablation:full": "node LegacySolver/solver-ablation.mjs --experiment=full --levels=all",
    "legacy:ablation:technique-budget": "node LegacySolver/solver-ablation.mjs --experiment=technique-budget --levels=all",
    "legacy:ablation:analyze": "node LegacySolver/analyze-ablation.mjs",
    "test:editor-validation": "node scripts/editor-validation-test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.54.2"
  }
}
