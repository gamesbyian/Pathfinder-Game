{
  "name": "pathfinder-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:dead-scripts": "node scripts/check-package-scripts.mjs",
    "check:secret-hygiene": "node scripts/check-secret-hygiene.mjs",
    "check:audit-artifacts": "node scripts/check-audit-artifacts.mjs",
    "check:third-party": "node scripts/check-third-party-dependencies.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:raw-inner-html": "node scripts/check-raw-inner-html.mjs",
    "check:modal-a11y": "node scripts/check-modal-a11y.mjs",
    "check:css-dead-components": "node scripts/check-css-dead-components.mjs",
    "check:css-class-coverage": "node scripts/check-css-class-coverage.mjs",
    "check:domain-purity": "node scripts/check-domain-purity.mjs",
    "check:no-solver-level-numbers": "node scripts/check-no-solver-level-numbers.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:audit-output": "node scripts/check-audit-output.mjs",
    "test:hint-path-oracle": "node scripts/hint-path-oracle.mjs",
    "test:loader": "tsx scripts/loader-unit-tests.mjs",
    "test:data-asset-runtime-smoke": "tsx scripts/data-asset-runtime-smoke-test.mjs",
    "test:firestore-rules": "node scripts/firestore-rules-test.mjs",
    "test:bundled-levels": "tsx scripts/validate-bundled-levels.mjs",
    "check": "npm run check:dead-scripts && npm run check:lint && npm run check:secret-hygiene && npm run check:audit-artifacts && npm run check:third-party && npm run check:csp && npm run check:raw-inner-html && npm run check:modal-a11y && npm run check:css-class-coverage && npm run check:css-dead-components && npm run check:engine-state-boundary && npm run check:domain-purity && npm run check:no-solver-level-numbers && npm run check:types",
    "ci": "npm run check && npm run test:coverage && npm run test:node",
    "ci:full": "npm run ci && npm run test:e2e",
    "test:startup-smoke": "node scripts/startup-smoke-test.mjs",
    "audit:newhint:full": "node scripts/run-audit-export.mjs",
    "solver:direct": "node scripts/run-bundled.mjs scripts/run-solverv2-direct.mjs",
    "solver:bench": "node scripts/run-bundled.mjs scripts/solver-bench.mjs",
    "ablation:run": "tsx scripts/run-ablation.mjs",
    "ablation:baseline": "tsx scripts/run-ablation.mjs --experiment=baseline",
    "ablation:single": "tsx scripts/run-ablation.mjs --experiment=single-feature",
    "ablation:profiles": "tsx scripts/run-ablation.mjs --experiment=profiles",
    "ablation:templates": "tsx scripts/run-ablation.mjs --experiment=templates",
    "ablation:order": "tsx scripts/run-ablation.mjs --experiment=order",
    "ablation:pairs": "tsx scripts/run-ablation.mjs --experiment=pairs",
    "ablation:full": "tsx scripts/run-ablation.mjs --experiment=full",
    "ablation:analyze": "node scripts/analyze-ablation.mjs",
    "test:editor-validation": "tsx scripts/editor-validation-test.mjs",
    "levels:import-published": "node scripts/import-published-levels.mjs",
    "levels:generate-heatmaps": "node scripts/generate-level-heatmaps.mjs",
    "levels:heatmap-report": "node scripts/level-heatmap-report.mjs",
    "levels:ratings-report": "node scripts/level-ratings-report.mjs",
    "check:engine-state-boundary": "node scripts/check-engine-state-boundary.mjs",
    "check:lint": "eslint modules/ scripts/ --max-warnings=0",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=chromium tests/smoke.spec.mjs tests/gameplay.spec.mjs",
    "test:e2e:a11y": "playwright test --project=chromium tests/a11y.spec.mjs",
    "test:e2e:editor": "playwright test --project=chromium tests/editor.spec.mjs",
    "test:e2e:security": "playwright test --project=chromium tests/security.spec.mjs tests/csp.spec.mjs",
    "test:e2e:theme": "playwright test --project=chromium tests/theme-coverage.spec.mjs",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:node": "npm run test:startup-smoke && npm run test:hint-path-oracle && npm run test:loader && npm run test:data-asset-runtime-smoke && npm run test:firestore-rules && npm run test:bundled-levels"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "playwright": "^1.54.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "tone": "^15.1.22"
  }
}
