rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'ianmakesjokes@gmail.com';
    }

    function validMetadata(data) {
      return data.levelData is map &&
             ('designerName' in data.levelData) &&
             ('description' in data.levelData) &&
             ('difficulty' in data.levelData) &&
             data.levelData.designerName is string && data.levelData.designerName.size() <= 80 &&
             data.levelData.description is string && data.levelData.description.size() <= 500 &&
             (data.levelData.difficulty == null || (data.levelData.difficulty is number && data.levelData.difficulty >= 1 && data.levelData.difficulty <= 10));
    }

    function validLevelEnvelope(data) {
      return data.levelFingerprint is string &&
             data.fingerprintVersion == 1 &&
             validMetadata(data);
    }

    match /artifacts/{appId}/users/{uid}/data/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /artifacts/{appId}/submissions/{submissionId} {
      allow create: if request.auth != null
                    && request.resource.data.submittedBy == request.auth.uid
                    && validLevelEnvelope(request.resource.data);
      allow read: if request.auth != null;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /artifacts/{appId}/published_levels/{levelId} {
      allow read: if true;
      allow create, update: if isAdmin() && validLevelEnvelope(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
